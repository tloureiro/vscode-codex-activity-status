{
  "name": "codex-activity-status",
  "displayName": "Codex Activity",
  "description": "A colored status-bar beacon for Codex activity, with opt-in project hooks and an optional detail panel.",
  "version": "0.4.5",
  "publisher": "tloureiro",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public": "node scripts/check-public-files.js",
    "check:workflows": "node scripts/check-workflows.js",
    "ci:local": "node scripts/ci-local.js",
    "sources:update": "node scripts/update-sources.js",
    "research:introspection": "node scripts/probe-vscode-introspection.js",
    "research:source-replay": "node research/introspection/source-replay.js",
    "research:hooks": "node research/hooks/probe.js",
    "validate": "npm run check && npm run lint && npm run format:check && npm run check:workflows && npm run check:public && npm test",
    "package": "mkdir -p dist && vsce package --no-rewrite-relative-links --out dist/",
    "test:vscode": "node scripts/test-activity-vscode.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "7.1.1"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexActivity.show",
        "title": "Codex Activity: Show Panel"
      },
      {
        "command": "codexActivity.repair",
        "title": "Codex Activity: Repair or Set Up"
      },
      {
        "command": "codexActivity.acknowledge",
        "title": "Codex Activity: Acknowledge"
      },
      {
        "command": "codexActivity.chooseScope",
        "title": "Codex Activity: Choose Project or Conversation"
      },
      {
        "command": "codexActivity.diagnostics",
        "title": "Codex Activity: Show Diagnostics"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "codexActivity",
          "title": "Codex Activity",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "codexActivity": [
        {
          "type": "webview",
          "id": "codexActivity.panel",
          "name": "Codex Activity",
          "contextualTitle": "Project activity",
          "visibility": "hidden"
        }
      ]
    },
    "configuration": {
      "title": "Codex Activity",
      "properties": {
        "codexActivity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show activity signals in the existing status bar for projects where you explicitly installed hooks."
        },
        "codexActivity.autoAcknowledge": {
          "type": "boolean",
          "default": false,
          "description": "Acknowledge unread completions when returning to this window. Off keeps the purple status-bar beacon until you acknowledge it."
        },
        "codexActivity.beaconWidth": {
          "type": "integer",
          "default": 24,
          "minimum": 8,
          "maximum": 48,
          "description": "Width of the colored status-bar strip in solid block characters. Uses status-bar width without reducing editor height."
        },
        "codexActivity.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to Node.js 18+ for installing the independent project helper. Empty detects a local Node installation. Changing this requires explicitly updating project hooks."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tloureiro/vscode-codex-activity-status.git"
  }
}

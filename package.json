{
  "name": "codex-activity-status",
  "displayName": "Codex Window Activity",
  "description": "Per-window Codex activity with steady blue, amber, and purple status-item colors (experimental local IDE bridge).",
  "version": "0.2.0",
  "publisher": "tloureiro",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public": "node scripts/check-public-files.js",
    "validate": "npm run check && npm run lint && npm run format:check && npm run check:public && npm test",
    "diagnostics": "node scripts/diagnostics.js",
    "prototype:appearance": "node scripts/prototype-appearance.js",
    "package": "mkdir -p dist && vsce package --no-rewrite-relative-links --out dist/",
    "test:vscode": "node scripts/test-vscode.js"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexActivity.setup",
        "title": "Codex Activity: Set Up Activity Colors"
      },
      {
        "command": "codexActivity.installBridge",
        "title": "Codex Activity: Set Up Experimental Codex Bridge"
      },
      {
        "command": "codexActivity.removeBridge",
        "title": "Codex Activity: Remove Bridge and Restore Appearance"
      },
      {
        "command": "codexActivity.acknowledge",
        "title": "Codex Activity: Acknowledge Completion"
      },
      {
        "command": "codexActivity.diagnostics",
        "title": "Codex Activity: Show Diagnostics"
      }
    ],
    "configuration": {
      "title": "Codex Window Activity",
      "properties": {
        "codexActivity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Monitor Codex in this window. Disabling restores appearance immediately."
        },
        "codexActivity.processingColor": {
          "type": "string",
          "default": "#245A91",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Opaque six-digit hex color while a turn is working.",
          "deprecationMessage": "Retired in 0.2.0. Activity uses fixed status-item colors; this setting is ignored."
        },
        "codexActivity.finishedColor": {
          "type": "string",
          "default": "#625B78",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Muted slate purple for unread successful completions.",
          "deprecationMessage": "Retired in 0.2.0. Activity uses fixed status-item colors; this setting is ignored."
        },
        "codexActivity.approvalColor": {
          "type": "string",
          "default": "#A66B16",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Amber for a real approval or structured input request.",
          "deprecationMessage": "Retired in 0.2.0. Activity uses fixed status-item colors; this setting is ignored."
        },
        "codexActivity.surface": {
          "type": "string",
          "enum": [
            "statusBar",
            "titleBar",
            "both"
          ],
          "default": "statusBar",
          "description": "Color the full status bar, title bar, or both. macOS title colors require a custom title bar.",
          "deprecationMessage": "Retired in 0.2.0. Activity uses fixed status-item colors; this setting is ignored."
        },
        "codexActivity.autoAcknowledge": {
          "type": "boolean",
          "default": true,
          "description": "Acknowledge unread completions on returning to this window, or on a subsequent keyboard/mouse text-editor selection change. Webview and terminal interactions are not exposed."
        }
      }
    },
    "colors": [
      {
        "id": "codexActivity.processingBackground",
        "description": "Codex processing status item background.",
        "defaults": {
          "dark": "#245A91",
          "light": "#245A91",
          "highContrast": "#245A91",
          "highContrastLight": "#245A91"
        }
      },
      {
        "id": "codexActivity.processingForeground",
        "description": "Codex processing status item foreground.",
        "defaults": {
          "dark": "#FFFFFF",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "codexActivity.approvalBackground",
        "description": "Codex approval status item background.",
        "defaults": {
          "dark": "#A66B16",
          "light": "#A66B16",
          "highContrast": "#A66B16",
          "highContrastLight": "#A66B16"
        }
      },
      {
        "id": "codexActivity.approvalForeground",
        "description": "Codex approval status item foreground.",
        "defaults": {
          "dark": "#000000",
          "light": "#000000",
          "highContrast": "#000000",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "codexActivity.finishedBackground",
        "description": "Codex finished status item background.",
        "defaults": {
          "dark": "#625B78",
          "light": "#625B78",
          "highContrast": "#625B78",
          "highContrastLight": "#625B78"
        }
      },
      {
        "id": "codexActivity.finishedForeground",
        "description": "Codex finished status item foreground.",
        "defaults": {
          "dark": "#FFFFFF",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#FFFFFF"
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tloureiro/vscode-codex-activity-status.git"
  }
}

{
  "name": "codex-activity-status",
  "displayName": "Codex Completion",
  "description": "A small, completion-only status indicator for Codex in VS Code.",
  "version": "0.3.0",
  "publisher": "tloureiro",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public": "node scripts/check-public-files.js",
    "validate": "npm run check && npm run lint && npm run format:check && npm run check:public && npm test",
    "package": "mkdir -p dist && vsce package --no-rewrite-relative-links --out dist/",
    "test:vscode": "node scripts/test-vscode.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexCompletion.setup",
        "title": "Codex Completion: Set Up"
      },
      {
        "command": "codexCompletion.cleanupLegacy",
        "title": "Codex Completion: Remove Legacy Hooks and Proxy"
      },
      {
        "command": "codexCompletion.removeIntegration",
        "title": "Codex Completion: Remove Integration"
      },
      {
        "command": "codexCompletion.acknowledge",
        "title": "Codex Completion: Acknowledge"
      },
      {
        "command": "codexCompletion.diagnostics",
        "title": "Codex Completion: Show Diagnostics"
      }
    ],
    "configuration": {
      "title": "Codex Completion",
      "properties": {
        "codexCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show completion notifications for Codex in this window."
        },
        "codexCompletion.autoAcknowledge": {
          "type": "boolean",
          "default": true,
          "description": "Acknowledge unread completions when returning to this window or interacting with a text editor."
        }
      }
    },
    "colors": [
      {
        "id": "codexCompletion.finishedForeground",
        "description": "Foreground for an unread Codex completion.",
        "defaults": {
          "dark": "#C8B7FF",
          "light": "#5B3F99",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tloureiro/vscode-codex-activity-status.git"
  }
}
